{
  "data": {
    "data_root": "Flickr30k",
    "image_dir": "Flickr30k_Images",
    "captions_file": "captions.txt",
    "split_file": "splits.json",
    "vocab_file": "vocab.json",
    "min_freq": 3,
    "max_vocab_size": 12000,
    "max_len": 32,
    "image_size": 384,
    "train_ratio": 0.8,
    "val_ratio": 0.1,
    "seed": 42,
    "num_workers": 4
  },
  "model": {
    "model_name": "m4",
    "d_model": 512,
    "hidden_dim": 512,
    "embed_dim": 512,
    "decoder_layers": 4,
    "attention_heads": 8,
    "dim_feedforward": 2048,
    "dropout": 0.1,
    "pretrained_encoder": true,
    "freeze_encoder": true,
    "encoder_weights_path": "/data/wyr/code/DeepLearning/exp/convnext_tiny-983f1562.pth"
  },
  "train": {
    "output_dir": "outputs",
    "batch_size": 48,
    "epochs_stage1": 22,
    "epochs_stage2": 6,
    "lr_decoder": 0.0003,
    "lr_encoder": 3e-05,
    "lr_decoder_stage2": 5e-05,
    "lr_encoder_stage2": 1e-05,
    "weight_decay": 0.0001,
    "warmup_steps": 1000,
    "grad_clip": 1.0,
    "label_smoothing": 0.1,
    "amp": true,
    "log_interval": 50,
    "seed": 42
  },
  "eval": {
    "split": "test",
    "batch_size": 32,
    "max_len": 32,
    "beam_size": 7,
    "length_penalty": 0.8,
    "use_beam": true
  }
}